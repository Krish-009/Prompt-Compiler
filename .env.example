# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- credentials -------------------------------------------------------------
# Gemini is the V1 primary; Groq is the fallback, used only when Gemini fails.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- model selection ---------------------------------------------------------
# Required: neither Gemini nor Groq has a built-in default, because a guessed id
# could silently select a paid model.
#
# PROMPT_COMPILER_MODEL applies to whichever provider you invoke. It does NOT
# apply to the fallback: model ids are not portable, and handing a Gemini id to
# Groq buys a 404 rather than a fallback. Give the fallback its own variable, or
# it will not attach at all (it says so on stderr when that happens).
PROMPT_COMPILER_GEMINI_MODEL=gemini-3.6-flash
PROMPT_COMPILER_GROQ_MODEL=openai/gpt-oss-20b

# --- optional ----------------------------------------------------------------
# PROMPT_COMPILER_PROVIDER=gemini
# PROMPT_COMPILER_FALLBACK=groq          # 'none' or 'off' disables it
# PROMPT_COMPILER_TIMEOUT=120
#
# Groq's free tier caps total tokens per minute at 8000, counting the prompt as
# well as the reply, so the default budget of 16000 is refused outright there
# with an HTTP 413 naming the limit. Lower this if Groq is doing real work.
# PROMPT_COMPILER_MAX_TOKENS=16000
